# Baseline image for DeepSeek V4 Flash on GB10 with the local SM12x static MLA
# path and FlashInfer B12x W4A16 MoE enabled.
#
# Build from the workspace root, not from the vLLM repo root, because this
# Dockerfile copies both ./vllm and the sibling ./flashinfer-latest checkout:
#
#   cd /home/aidendle94/Documents/workspace
#   DOCKER_BUILDKIT=1 docker build -f vllm/Dockerfile.baseline \
#     --build-arg BASE_IMAGE=<vllm-openai-system-nccl-base-image> \
#     -t <baseline-image-tag> .

ARG BASE_IMAGE=sparkrun-vllm-ds4-gb10:ae353d502-static-mla-dirty-20260518T000139Z-cuda13.2-nccl2.30-vllm-openai-base
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="DeepSeek V4 Flash GB10 FlashInfer static MLA baseline"
LABEL org.opencontainers.image.description="vLLM static SM12x MLA/MQA plus FlashInfer B12x W4A16 MoE baseline for two-node GB10 sparkrun."

COPY vllm/vllm/envs.py /usr/local/lib/python3.12/dist-packages/vllm/envs.py
COPY vllm/vllm/config/kernel.py /usr/local/lib/python3.12/dist-packages/vllm/config/kernel.py
COPY vllm/vllm/utils/flashinfer.py /usr/local/lib/python3.12/dist-packages/vllm/utils/flashinfer.py
COPY vllm/vllm/model_executor/layers/fused_moe/modular_kernel.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/modular_kernel.py
COPY vllm/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py
COPY vllm/vllm/model_executor/layers/fused_moe/experts/flashinfer_b12x_moe.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/experts/flashinfer_b12x_moe.py
COPY vllm/vllm/tool_parsers/deepseekv32_tool_parser.py /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/deepseekv32_tool_parser.py
COPY vllm/vllm/v1/attention/backends/mla/sparse_mla_kernels.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/mla/sparse_mla_kernels.py
COPY vllm/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_deep_gemm_fallbacks.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_deep_gemm_fallbacks.py
COPY vllm/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_mqa.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_mqa.py
COPY vllm/vllm/v1/attention/ops/deepseek_v4_ops/fp8_einsum.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/fp8_einsum.py

COPY flashinfer-latest/flashinfer/fused_moe/cute_dsl/blackwell_sm12x /usr/local/lib/python3.12/dist-packages/flashinfer/fused_moe/cute_dsl/blackwell_sm12x
COPY flashinfer-latest/flashinfer/cute_dsl/utils.py /usr/local/lib/python3.12/dist-packages/flashinfer/cute_dsl/utils.py
COPY flashinfer-latest/flashinfer/cute_dsl/fp4_common.py /usr/local/lib/python3.12/dist-packages/flashinfer/cute_dsl/fp4_common.py
COPY flashinfer-latest/flashinfer/gemm/kernels/dense_blockscaled_gemm_sm120_b12x.py /usr/local/lib/python3.12/dist-packages/flashinfer/gemm/kernels/dense_blockscaled_gemm_sm120_b12x.py

RUN python3 -m py_compile \
      /usr/local/lib/python3.12/dist-packages/vllm/envs.py \
      /usr/local/lib/python3.12/dist-packages/vllm/config/kernel.py \
      /usr/local/lib/python3.12/dist-packages/vllm/utils/flashinfer.py \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/modular_kernel.py \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/oracle/mxfp4.py \
      /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/fused_moe/experts/flashinfer_b12x_moe.py \
      /usr/local/lib/python3.12/dist-packages/vllm/tool_parsers/deepseekv32_tool_parser.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/mla/sparse_mla_kernels.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_deep_gemm_fallbacks.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/sm12x_mqa.py \
      /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/deepseek_v4_ops/fp8_einsum.py && \
    VLLM_USE_FLASHINFER_MOE_B12X_W4A16=1 python3 - <<'PY'
from vllm.utils.flashinfer import has_flashinfer_b12x_fused_moe

assert has_flashinfer_b12x_fused_moe()
PY
